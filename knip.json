{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/main.tsx",
    "vite.config.ts",
    "functions/**/*.ts",
    "workers/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "functions/**/*.ts",
    "workers/**/*.ts"
  ],
  "ignore": [
    "tests/helpers/**",
    "**/*.d.ts"
  ]
}
